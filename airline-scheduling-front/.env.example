# Configuration des variables d'environnement
# Copier ce fichier en .env.local et adapter les valeurs

# Backend API URL
REACT_APP_API_URL=http://localhost:3000/api

# Optionnel: Configuration d'authentification
# REACT_APP_AUTH_TOKEN=votre_token_ici

# Optionnel: Configuration de logging
# REACT_APP_LOG_LEVEL=debug

# Optionnel: Timeout des requêtes (millisecondes)
# REACT_APP_API_TIMEOUT=30000
